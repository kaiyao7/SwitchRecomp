{
  "version": "0.1",
  "source": "ARM Architecture Reference Manual ARMv8-A (AArch64)",
  "note": "Encoding tables for the 20 core instructions of Phase 1. Each entry uses fixed_bits (the bits that identify the opcode) and a field list. Use (encoding & mask) == value to identify; extract fields from field bit ranges.",
  "instructions": [
    {
      "mnemonic": "ADD",
      "variant": "immediate",
      "category": "data_processing_immediate",
      "syntax": "ADD <Wd|WSP>, <Wn|WSP>, #<imm>{, <shift>}",
      "sf_bit": 31,
      "fixed_bits": { "value": "0b00010001000000000000000000000000", "mask": "0b01111111100000000000000000000000" },
      "mask": "0x7F800000",
      "value": "0x11000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit (X), 0=32-bit (W)" },
        { "name": "op", "bits": "30", "desc": "0=ADD, 1=SUB" },
        { "name": "S", "bits": "29", "desc": "set NZCV flags" },
        { "name": "sh", "bits": "23", "desc": "0=LSL #0, 1=LSL #12" },
        { "name": "imm12", "bits": "22-10", "desc": "unsigned immediate" },
        { "name": "Rn", "bits": "9-5", "desc": "source register" },
        { "name": "Rd", "bits": "4-0", "desc": "destination register" }
      ],
      "affects_flags": "if S=1: N,Z,C,V",
      "pseudocode": "Rd = Rn + ZeroExtend(imm12 << (sh*12))"
    },
    {
      "mnemonic": "SUB",
      "variant": "immediate",
      "category": "data_processing_immediate",
      "syntax": "SUB <Wd|WSP>, <Wn|WSP>, #<imm>{, <shift>}",
      "sf_bit": 31,
      "mask": "0x7F800000",
      "value": "0x51000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "op", "bits": "30", "desc": "0=ADD, 1=SUB" },
        { "name": "S", "bits": "29", "desc": "set NZCV flags" },
        { "name": "sh", "bits": "23", "desc": "0=LSL #0, 1=LSL #12" },
        { "name": "imm12", "bits": "22-10", "desc": "unsigned immediate" },
        { "name": "Rn", "bits": "9-5", "desc": "source register" },
        { "name": "Rd", "bits": "4-0", "desc": "destination register" }
      ],
      "affects_flags": "if S=1: N,Z,C,V",
      "pseudocode": "Rd = Rn - ZeroExtend(imm12 << (sh*12))"
    },
    {
      "mnemonic": "ADD",
      "variant": "shifted_register",
      "category": "data_processing_register",
      "syntax": "ADD <Wd>, <Wn>, <Wm>{, <shift> #<amount>}",
      "sf_bit": 31,
      "mask": "0x7F200000",
      "value": "0x0B000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "op", "bits": "30", "desc": "0=ADD, 1=SUB" },
        { "name": "S", "bits": "29", "desc": "set NZCV" },
        { "name": "shift", "bits": "23-22", "desc": "00=LSL,01=LSR,10=ASR,11=RRX" },
        { "name": "Rm", "bits": "20-16", "desc": "second source register" },
        { "name": "imm6", "bits": "15-10", "desc": "shift amount" },
        { "name": "Rn", "bits": "9-5", "desc": "first source" },
        { "name": "Rd", "bits": "4-0", "desc": "destination" }
      ],
      "affects_flags": "if S=1: N,Z,C,V",
      "pseudocode": "Rd = Rn + Shift(Rm, shift, imm6)"
    },
    {
      "mnemonic": "SUB",
      "variant": "shifted_register",
      "category": "data_processing_register",
      "syntax": "SUB <Wd>, <Wn>, <Wm>{, <shift> #<amount>}",
      "sf_bit": 31,
      "mask": "0x7F200000",
      "value": "0x4B000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "op", "bits": "30", "desc": "0=ADD, 1=SUB" },
        { "name": "S", "bits": "29", "desc": "set NZCV" },
        { "name": "shift", "bits": "23-22", "desc": "00=LSL,01=LSR,10=ASR,11=RRX" },
        { "name": "Rm", "bits": "20-16", "desc": "second source" },
        { "name": "imm6", "bits": "15-10", "desc": "shift amount" },
        { "name": "Rn", "bits": "9-5", "desc": "first source" },
        { "name": "Rd", "bits": "4-0", "desc": "destination" }
      ],
      "affects_flags": "if S=1: N,Z,C,V",
      "pseudocode": "Rd = Rn - Shift(Rm, shift, imm6)"
    },
    {
      "mnemonic": "AND",
      "variant": "shifted_register",
      "category": "logical_register",
      "syntax": "AND <Wd>, <Wn>, <Wm>{, <shift> #<amount>}",
