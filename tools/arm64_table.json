      "mask": "0x7F200000",
      "value": "0x0A000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "opc", "bits": "30-29", "desc": "00=AND,01=BIC,10=ORR,11=ORN, plus EOR at opc=10 with bit28=1" },
        { "name": "shift", "bits": "23-22", "desc": "00=LSL,01=LSR,10=ASR,11=RRX" },
        { "name": "Rm", "bits": "20-16", "desc": "second source" },
        { "name": "imm6", "bits": "15-10", "desc": "shift amount" },
        { "name": "Rn", "bits": "9-5", "desc": "first source" },
        { "name": "Rd", "bits": "4-0", "desc": "destination" }
      ],
      "affects_flags": "no (ANDS sets flags; separate encoding)",
      "pseudocode": "Rd = Rn AND Shift(Rm, shift, imm6)"
    },
    {
      "mnemonic": "ORR",
      "variant": "shifted_register",
      "category": "logical_register",
      "syntax": "ORR <Wd>, <Wn>, <Wm>{, <shift> #<amount>}",
      "sf_bit": 31,
      "mask": "0x7F200000",
      "value": "0x2A000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "opc", "bits": "30-29", "desc": "10=ORR" },
