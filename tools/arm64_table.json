      "sf_bit": 31,
      "mask": "0x7F800000",
      "value": "0x13000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "N", "bits": "22", "desc": "register size flag" },
        { "name": "immr", "bits": "21-16", "desc": "rotate right amount (= shift)" },
        { "name": "imms", "bits": "15-10", "desc": "mask msb" },
