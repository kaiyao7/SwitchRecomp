    {
      "mnemonic": "EOR",
      "variant": "shifted_register",
      "category": "logical_register",
      "syntax": "EOR <Wd>, <Wn>, <Wm>{, <shift> #<amount>}",
      "sf_bit": 31,
      "mask": "0x7F200000",
      "value": "0x4A000000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "opc", "bits": "30-29", "desc": "10=EOR (with bit28=1)" },
        { "name": "shift", "bits": "23-22", "desc": "00=LSL,01=LSR,10=ASR,11=RRX" },
        { "name": "Rm", "bits": "20-16", "desc": "second source" },
        { "name": "imm6", "bits": "15-10", "desc": "shift amount" },
        { "name": "Rn", "bits": "9-5", "desc": "first source" },
        { "name": "Rd", "bits": "4-0", "desc": "destination" }
      ],
      "affects_flags": "no",
      "pseudocode": "Rd = Rn XOR Shift(Rm, shift, imm6)"
    },
    {
      "mnemonic": "MOVZ",
      "variant": "wide_immediate",
      "category": "wide_immediate",
      "syntax": "MOVZ <Wd>, #<imm>{, LSL #<shift>}",
      "note": "assembler alias MOV <Wd>, #<imm> maps to MOVZ",
      "sf_bit": 31,
      "mask": "0x7F800000",
      "value": "0x52800000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "opc", "bits": "30-29", "desc": "10=MOVZ" },
        { "name": "hw", "bits": "22-21", "desc": "shift amount / 16 (0,1,2,3)" },
        { "name": "imm16", "bits": "20-5", "desc": "16-bit immediate" },
        { "name": "Rd", "bits": "4-0", "desc": "destination" }
      ],
      "affects_flags": "no",
      "pseudocode": "Rd = ZeroExtend(imm16) << (hw*16)"
    },
    {
      "mnemonic": "MOVN",
      "variant": "wide_immediate",
      "category": "wide_immediate",
      "syntax": "MOVN <Wd>, #<imm>{, LSL #<shift>}",
      "note": "assembler alias MVN <Wd>, #<imm> maps to MOVN",
      "sf_bit": 31,
      "mask": "0x7F800000",
      "value": "0x12800000",
      "fields": [
        { "name": "sf", "bits": "31", "desc": "1=64-bit, 0=32-bit" },
        { "name": "opc", "bits": "30-29", "desc": "00=MOVN" },
        { "name": "hw", "bits": "22-21", "desc": "shift amount / 16" },
