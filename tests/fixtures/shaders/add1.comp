#version 450
// Minimal compute shader: increment every uint element by one.
// Used by the Phase 4-1 end-to-end compute dispatch test.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Data { uint values[]; } data;
void main() {
    uint i = gl_GlobalInvocationID.x;
    data.values[i] = data.values[i] + 1u;
}
